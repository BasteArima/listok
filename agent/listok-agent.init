#!/bin/sh /etc/rc.common
# listok-agent: один процесс procd на все секции из /etc/config/listok. docs/router-agent.md
START=99
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/listok-agent run
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger listok
}
