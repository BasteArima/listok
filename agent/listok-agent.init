#!/bin/sh /etc/rc.common
# listok-agent: по процессу procd на каждую секцию из /etc/config/listok. docs/router-agent.md
START=99
USE_PROCD=1

start_feed() {
	local section
	config_get section "$1" section
	[ -n "$section" ] || return 0
	procd_open_instance "$section"
	procd_set_param command /usr/bin/listok-agent run "$section"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

start_service() {
	config_load listok
	config_foreach start_feed feed
}

service_triggers() {
	procd_add_reload_trigger listok
}
