#!/bin/sh
# Установщик агента listok. Ссылка одноразовая: повторный запуск — с новой ссылкой из интерфейса.
# Что делает: docs/router-agent.md, раздел «Установка».
set -e

SERVER='[[.Server]]'
SECTIONS='[[range $i, $f := .Feeds]][[if $i]] [[end]][[$f.Section]][[end]]'

say() { echo "listok: $*"; }
die() { echo "listok: ОШИБКА: $*" >&2; exit 1; }

[ "$(id -u)" = 0 ] || die "запускать от root"
[ -x /usr/bin/forkop ] || die "forkop не найден (/usr/bin/forkop)"
command -v ucode >/dev/null || die "нет ucode"
command -v curl >/dev/null || die "нет curl"

# Секции ищет сам агент: в forkop 2 это название из LuCI (option label), в 1.x — имя секции.
mkdir -p /tmp/listok
cat > /tmp/listok/listok-agent <<'LISTOK_AGENT_EOF'
[[.AgentCode]]LISTOK_AGENT_EOF
ucode /tmp/listok/listok-agent check $SECTIONS || exit 1

STAMP=$(date +%Y%m%d-%H%M%S)
cp /etc/config/forkop "/etc/config/forkop.bak-listok-$STAMP"
say "бэкап настроек forkop: /etc/config/forkop.bak-listok-$STAMP"

mkdir -p /etc/listok
mv /tmp/listok/listok-agent /usr/bin/listok-agent
chmod 755 /usr/bin/listok-agent

cat > /etc/init.d/listok-agent <<'LISTOK_INIT_EOF'
[[.InitCode]]LISTOK_INIT_EOF
chmod 755 /etc/init.d/listok-agent

# Токены секретные: конфиг читает только root.
( umask 077; cat > /etc/config/listok <<'LISTOK_CONFIG_EOF'
config agent 'agent'
	option server '[[.Server]]'
[[- if .ServerIP]]
	option server_ip '[[.ServerIP]]'
[[- end]]
	option token '[[.AgentToken]]'
	option mode '[[.Mode]]'
[[- if eq .Mode "poll"]]
	option interval '[[.IntervalS]]'
[[- end]]
[[range .Feeds]]
config feed
	option section '[[.Section]]'
	option token '[[.Token]]'
[[end]]
LISTOK_CONFIG_EOF
)

for s in $SECTIONS; do
	say "первая загрузка фида секции $s"
	/usr/bin/listok-agent sync "$s" || die "не удалось скачать фид секции $s — проверьте связь роутера с $SERVER"
done

# В forkop: файлы /etc/listok/<секция>.lst подключаются к секциям (forkop 1 — domain_ip_lists,
# forkop 2 — rule_set_with_subnets), ссылки на фиды этого сервера, если их вставляли вручную,
# убираются. Локальный путь forkop читает синхронно при старте, без гонки (forkop-integration.md).
# Если нужное уже стоит (переустановка), forkop не трогаем и не перезапускаем.
/usr/bin/listok-agent attach $SECTIONS || die "не удалось подключить списки к forkop — бэкап: /etc/config/forkop.bak-listok-$STAMP"
/etc/init.d/listok-agent enable
/etc/init.d/listok-agent restart

say "готово. Состояние: listok-agent status, журнал: logread -e listok-agent"
say "удалить: listok-agent uninstall"
